POSTGRES_DB=widget_platform
POSTGRES_USER=widget_user
POSTGRES_PASSWORD=widget_pass
POSTGRES_PORT=5432

DATABASE_URL=postgres://widget_user:widget_pass@localhost:5432/widget_platform

PORT=3000
NODE_ENV=development

SESSION_SECRET=flyrank-local-development-secret

RATE_LIMIT_IP_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_WIDGET_WINDOW_MS=60000
RATE_LIMIT_WIDGET_MAX=20

# Geo providers: live | mock | down   (npm test always forces "down")
GEO_PROVIDER_A_MODE=live
GEO_PROVIDER_B_MODE=live
GEO_PROVIDER_TIMEOUT_MS=3000

# Demo/test switch: makes the confirmation email handler throw
EMAIL_FORCE_FAIL=false

# Login/signup attempts allowed per IP per window (15 min)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

JOB_POLL_INTERVAL_MS=2000