{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "migrate:create": "dotenv -e ../.env -- node-pg-migrate create --migrations-dir src/db/migrations",
    "migrate:up": "dotenv -e ../.env -- node-pg-migrate up --migrations-dir src/db/migrations",
    "migrate:down": "dotenv -e ../.env -- node-pg-migrate down --migrations-dir src/db/migrations",
    "build:widget": "node scripts/build-widget.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14"
  }
}
